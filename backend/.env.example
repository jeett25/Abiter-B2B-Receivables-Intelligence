# Copy to .env and fill in. Never commit .env.

# --- Database (Day 1) ---
# Postgres runs via Docker (pgvector/pgvector:pg18) on host port 5433,
# separate from any native local PostgreSQL on 5432.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/receivables_ai

SEED=42

# --- Redis (Day 4+, not needed yet) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM provider (Day 4+, LangGraph reasoning layer) ---
LLM_API_KEY=

# --- Razorpay test mode (Day 4+, PAYMENT_LINK action) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
